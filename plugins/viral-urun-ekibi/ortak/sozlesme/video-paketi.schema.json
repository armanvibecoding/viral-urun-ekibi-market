{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "sozlesme/video-paketi.schema.json",
  "title": "video-paketi.json (sürüm 1)",
  "description": "Video yapan plugin üretir, Mağaza Kurucu (shopify-kurulum) okur; yalnız pdp-galeri ve hero olanlar mağazaya yüklenir. Alan açıklamaları: arayuz-sozlesmesi.md.",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["dosya", "olcu", "sure_sn", "kullanim"],
    "properties": {
      "dosya": { "type": "string", "minLength": 1 },
      "olcu": { "type": "string", "pattern": "^[0-9]+x[0-9]+$" },
      "sure_sn": { "type": "number", "minimum": 0 },
      "kullanim": { "enum": ["pdp-galeri", "hero", "reklam"] },
      "altyazi_dili": { "type": ["string", "null"] }
    }
  }
}
